  "note": "三维选型层（只读）：皮肤 styles × 骨架 concepts × 笔触 media。每项 mapsTo 引用现有 effect/combo/shot；snippet 指向 snippets/ 下复制即用片段。配合决策路由表使用：intake → 查表 → 取片段 → 填内容 → 跑 gate。",
  "principles": [
    {
      "id": "continuous-world",
      "label": "一个连续世界",
      "detail": "场景在同一个世界里连续演化，而不是一段段幻灯片。",
      "checks": [
        "同一场景内的元素跨镜头持续",
        "切换靠相机/变形，而非整屏淡入淡出"
      ]
    },
    {
      "id": "moving-camera",
      "label": "真动相机",
      "detail": "相机始终有动机地移动（呼吸漂移 + 推进），不要固定机位。",
      "checks": [
        "待机时有轻微呼吸",
        "每次推进都有叙事动机",
        "移动由弹簧/曲线驱动，不匀速"
      ]
    },
    {
      "id": "persisting-subject",
      "label": "主体持续",
      "detail": "主体在镜头间持续存在，而不是每个镜头重新出现。",
      "checks": [
        "主体跨镜头不被裁切重置",
        "位置/尺寸变化用同一元素的连续运动"
      ]
    },
    {
      "id": "text-in-scene",
      "label": "场景内文字",
      "detail": "文字活在场景里，有空间关系，不是贴在屏幕正中的标签。",
      "checks": [
        "文字随场景移动",
        "避免长期居中大字",
        "进出时机与运动对齐"
      ]
    },
    {
      "id": "moving-background",
      "label": "背景不静止",
      "detail": "背景始终有轻微运动（视差/漂移/纹理流动），世界不停。",
      "checks": [
        "背景有至少一层慢速运动",
        "运动与前景形成速度差"
      ]
    },
    {
      "id": "footage-locked-timeline",
      "label": "素材锁时间轴",
      "detail": "素材/事件在时间轴上锁定，任何时刻 seek 都得到同一帧。",
      "checks": [
        "无 Math.random/时钟/定时器",
        "随机只用固定种子",
        "改动是重排 cue 而非重录"
      ]
    }
  ],
