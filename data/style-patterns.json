      "detail": "360px 宽下文字与主体清晰可读"
    },
    {
      "id": "motion",
      "label": "运动质量",
      "detail": "用弹簧/缓动，无滑动感、无死帧"
    },
    {
      "id": "variety",
      "label": "多样性",
      "detail": "每 2–4 秒有新事件或新技法"
    },
    {
      "id": "brand",
      "label": "品牌一致性",
      "detail": "调色、字体、风格统一"
    },
    {
      "id": "sound",
      "label": "声画同步",
      "detail": "如有配乐/音效，卡点与画面一致"
    }
  ],
  "fixRunbook": [
    {
      "id": "F1",
      "symptom": "文字 swap 时新旧文字重叠",
      "detect": "contact sheet 或展开片段，看到两段文字同时出现",
      "fix": "用 swapAlpha(t,tIn,tOut)：新文字在 morph 开始后进入、旧文字在下一阶段前离开，进出错开约 0.1s"
    },
    {
      "id": "F2",
      "symptom": "该缓动却在滑动（linear、匀速）",
      "detect": "strip（连续 12 帧）里位移间距均匀、无加减速",
      "fix": "把 linear 换成闭式弹簧 spring(t,k,d)；按钮/前沿用 k=320,卡片 k=170,大字 k=120"
    },
    {
      "id": "F3",
      "symptom": "缩放/放大后文字发虚模糊",
      "detect": "放大后的帧文字不锐利",
      "fix": "对被相机缩放的元素不要用 will-change；缩放结束后让文字回到 1.0 尺度再排版，或用子帧混合"
    },
    {
      "id": "F4",
      "symptom": "循环接缝卡顿、跳变",
      "detect": "loop_check（连放两遍）首尾衔接处有跳变",
      "fix": "让最后一帧等于第一帧（含光标位置与速度）；用 loopT(t,dur) 包裹时间"
    },
    {
      "id": "F5",
      "symptom": "死帧 / dead air（超过 4 秒无事件）",
      "detect": "gate 的 dead air WARN；contact sheet 上相邻帧无变化",
      "fix": "在空档插入次级运动（呼吸漂移、背景缓动、局部推进），或压缩该段时长"
    },
    {
      "id": "F6",
      "symptom": "居中渐变 + 全 fade（slop 信号）",
      "detect": "连续出现居中文字、所有元素淡入淡出",
      "fix": "改用非对称构图与逐笔/位移/遮罩入场；一帧内元素用 stagger 错峰，不要同时 fade"
    },
    {
      "id": "F7",
      "symptom": "元素同时全动、没有层次",
      "detect": "一个镜头里所有元素同一时刻开始运动",
      "fix": "按 i*0.03 加 stagger；前景/中景/背景分层，运动方向与速度不同"
    },
    {
      "id": "F8",
      "symptom": "灰块划过之后图片仍是 A、没切到 B",
      "detect": "wipe 完成后画面未更新",
      "fix": "在灰块完全覆盖（遮罩值=1）的瞬间切换 A→B，再让灰块划出；切换时机锁在 cue 表"
    },
    {
      "id": "F9",
      "symptom": "音效与画面不同步",
      "detect": "whoosh/click 落在动作之外",
      "fix": "先用 librosa 测 beat grid 写 beats.json，把状态变化放在 beat、音效放在 onset hit"
    },
    {
      "id": "F10",
      "symptom": "手机尺寸下文字太小/不可读",
      "detect": "phone test（360px 缩略图）文字看不清",
      "fix": "竖版关键文字占屏宽 ≥70%，正文字号上调；避免长段文字，拆成大字短句"
    }
  ]
}